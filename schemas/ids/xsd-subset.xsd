<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="http://www.w3.org/2001/XMLSchema"
           elementFormDefault="qualified">
  <xs:element name="restriction">
    <xs:complexType>
      <xs:choice minOccurs="0" maxOccurs="unbounded">
        <xs:element name="pattern"      type="xs:valued"/>
        <xs:element name="enumeration"  type="xs:valued"/>
        <xs:element name="minInclusive" type="xs:valued"/>
        <xs:element name="maxInclusive" type="xs:valued"/>
        <xs:element name="minExclusive" type="xs:valued"/>
        <xs:element name="maxExclusive" type="xs:valued"/>
        <xs:element name="length"       type="xs:valued"/>
        <xs:element name="minLength"    type="xs:valued"/>
        <xs:element name="maxLength"    type="xs:valued"/>
      </xs:choice>
      <xs:attribute name="base" type="xs:string" use="required"/>
    </xs:complexType>
  </xs:element>
  <xs:complexType name="valued">
    <xs:attribute name="value" type="xs:string" use="required"/>
  </xs:complexType>
  <xs:attributeGroup name="occurs">
    <xs:attribute name="minOccurs" type="xs:nonNegativeInteger" use="optional" default="1"/>
    <xs:attribute name="maxOccurs" use="optional" default="1">
      <xs:simpleType>
        <xs:union memberTypes="xs:nonNegativeInteger">
          <xs:simpleType><xs:restriction base="xs:string"><xs:enumeration value="unbounded"/></xs:restriction></xs:simpleType>
        </xs:union>
      </xs:simpleType>
    </xs:attribute>
  </xs:attributeGroup>
</xs:schema>
