<?xml version="1.0" encoding="utf-8"?>
<!--
  The CamelWorks ribbon tab: one panel, fourteen buttons — the suite, flat.

  Hand-authored Navisworks markup, not WPF - the project file removes it from Page compilation and
  deploys it to an en-US subfolder beside the DLL, which is where the host looks for it. Nothing
  compiles this file, so nothing but checks/validate-ribbon.py will ever tell you it is wrong.

  ONE BUTTON PER APP, AT ONE SIZE. The shape of the plug-in collections the client named: a flat
  row of named apps, each opening its own self-contained window with its modes as tabs across the
  top. The hub leads, the eleven apps follow in the catalogue's order, and the two commands that
  are not apps - the section-box act and Help - stack at the end.

  LAYOUT. A RibbonPanelSource lays its children out left to right, one column each. A Large button
  stands alone in its column; Standard buttons only stack when wrapped in a RibbonRowPanel with a
  RibbonRowBreak between the rows. Twelve Large columns plus one stack of two comes to roughly
  700px, which sits whole on any laptop.

  Every button is a real AdWindows item, so right-click -> Add to Quick Access Toolbar works on
  all of them. That is the whole personalisation story on purpose.

  ONE TAB FOR THE WHOLE TOOLSET. The tab id is ID_Tab_BIMCamel, which Dyncamelo and the BIMCamel
  IFC exporter also declare. Navisworks does not merge tabs that share an id - it composes each
  plug-in's layout separately, so three installed tools would give three tabs all called BIMCamel.
  Shell/RibbonTabMerger.cs folds them into one at startup; all three plug-ins carry a copy of it.
-->
<RibbonControl
    x:Uid="CamelWorks"
    xmlns="clr-namespace:Autodesk.Windows;assembly=AdWindows"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Autodesk.Navisworks.Gui.Roamer.AIRLook;assembly=navisworks.gui.roamer">

  <RibbonTab Id="ID_Tab_BIMCamel" Title="BIMCamel" KeyTip="BC">

    <RibbonPanel x:Uid="RibbonPanel_CW_Suite">
      <RibbonPanelSource x:Uid="RibbonPanelSource_CW_Suite" Title="CamelWorks">
        <local:NWRibbonButton x:Uid="CW_AppClash" Id="ID_CW_AppClash"
                              Size="Large" ShowText="True" Orientation="Vertical" />
        <local:NWRibbonButton x:Uid="CW_AppIssueManager" Id="ID_CW_AppIssueManager"
                              Size="Large" ShowText="True" Orientation="Vertical" />
        <local:NWRibbonButton x:Uid="CW_AppAudit" Id="ID_CW_AppAudit"
                              Size="Large" ShowText="True" Orientation="Vertical" />
        <local:NWRibbonButton x:Uid="CW_AppTrack" Id="ID_CW_AppTrack"
                              Size="Large" ShowText="True" Orientation="Vertical" />
        <local:NWRibbonButton x:Uid="CW_AppData" Id="ID_CW_AppData"
                              Size="Large" ShowText="True" Orientation="Vertical" />
        <local:NWRibbonButton x:Uid="CW_AppQuantify" Id="ID_CW_AppQuantify"
                              Size="Large" ShowText="True" Orientation="Vertical" />
        <local:NWRibbonButton x:Uid="CW_AppSets" Id="ID_CW_AppSets"
                              Size="Large" ShowText="True" Orientation="Vertical" />
        <local:NWRibbonButton x:Uid="CW_AppScenes" Id="ID_CW_AppScenes"
                              Size="Large" ShowText="True" Orientation="Vertical" />
        <local:NWRibbonButton x:Uid="CW_AppExports" Id="ID_CW_AppExports"
                              Size="Large" ShowText="True" Orientation="Vertical" />
        <local:NWRibbonButton x:Uid="CW_AppSite" Id="ID_CW_AppSite"
                              Size="Large" ShowText="True" Orientation="Vertical" />
        <local:NWRibbonButton x:Uid="CW_AppAutomate" Id="ID_CW_AppAutomate"
                              Size="Large" ShowText="True" Orientation="Vertical" />
        <RibbonRowPanel x:Uid="RibbonRow_CW_Suite">
          <local:NWRibbonButton x:Uid="CW_SectionBox" Id="ID_CW_SectionBox"
                                Size="Standard" ShowText="True" Orientation="Horizontal" />
          <RibbonRowBreak x:Uid="RibbonBreak_CW_Suite_1" />
          <local:NWRibbonButton x:Uid="CW_Help" Id="ID_CW_Help"
                                Size="Standard" ShowText="True" Orientation="Horizontal" />
        </RibbonRowPanel>
      </RibbonPanelSource>
    </RibbonPanel>

  </RibbonTab>
</RibbonControl>
